# Site (used by OG image + metadata)
NEXT_PUBLIC_SITE_URL=https://henry-hudieres.dev

# Resend — https://resend.com
RESEND_API_KEY=re_...
CONTACT_FROM="Portfolio <hello@your-verified-domain.dev>"
CONTACT_TO=hhudieres7@gmail.com

# Upstash Redis Ratelimit — https://upstash.com
# Optional. If both are unset, /api/contact falls back to a per-instance
# in-memory limiter, which still throttles but does not share counts across
# serverless instances. Set these for real distributed rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
